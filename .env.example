# Copy to .env.local (git-ignored) and restart `npx expo start -c`.
# Get a free key at https://aistudio.google.com/apikey
# EXPO_PUBLIC_ values are bundled into the app: use a real key for development only.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional overrides
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash-lite
# EXPO_PUBLIC_GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# EXPO_PUBLIC_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# EXPO_PUBLIC_GEMINI_VOICE=Sulafat   # warm female; try Achernar, Vindemiatrix, Despina, Leda
# EXPO_PUBLIC_GEMINI_TTS=off            # use the device voice instead of Gemini TTS
# EXPO_PUBLIC_GEMINI_BASE_URL=https://your-proxy.example.com/v1beta   # release builds: your own server adds the key
# EXPO_PUBLIC_GEMINI_TRANSLATE_MODEL=gemini-3.5-flash-lite

# MenTalk server. When set, sign-in, chat, voice, hints and word lookup go through it and no Gemini key is needed.
# Android emulator: http://10.0.2.2:8000/api/v1   Real device: http://<your-LAN-IP>:8000/api/v1
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=      # the same "Web" client ID the server lists in GOOGLE_CLIENT_IDS
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
